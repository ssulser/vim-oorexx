--langdef=ooRexx
--map-ooRexx=+.rex
--map-ooRexx=+.rexx
--map-ooRexx=+.cls
--kinddef-ooRexx=c,class,classes
--kinddef-ooRexx=m,method,methods
--kinddef-ooRexx=r,routine,routines
--kinddef-ooRexx=p,procedure,procedures
--kinddef-ooRexx=a,attribute,attributes
--kinddef-ooRexx=k,constant,constants
--kinddef-ooRexx=n,annotation,annotations
--kinddef-ooRexx=s,resource,resources
--kinddef-ooRexx=q,require,requires
--kinddef-ooRexx=o,option,options
--regex-ooRexx=/^[ \t]*::[Cc][Ll][Aa][Ss][Ss][ \t]+['"]?([A-Za-z_][A-Za-z0-9_!?]*)['"]?/\1/c,class/
--regex-ooRexx=/^[ \t]*::[Mm][Ee][Tt][Hh][Oo][Dd][ \t]+['"]?([A-Za-z_][A-Za-z0-9_!?]*)['"]?/\1/m,method/
--regex-ooRexx=/^[ \t]*::[Rr][Oo][Uu][Tt][Ii][Nn][Ee][ \t]+['"]?([A-Za-z_][A-Za-z0-9_!?]*)['"]?/\1/r,routine/
--regex-ooRexx=/^[ \t]*::[Aa][Tt][Tt][Rr][Ii][Bb][Uu][Tt][Ee][ \t]+['"]?([A-Za-z_][A-Za-z0-9_!?]*)['"]?/\1/a,attribute/
--regex-ooRexx=/^[ \t]*::[Cc][Oo][Nn][Ss][Tt][Aa][Nn][Tt][ \t]+['"]?([A-Za-z_][A-Za-z0-9_!?]*)['"]?/\1/k,constant/
--regex-ooRexx=/^[ \t]*::[Rr][Ee][Ss][Oo][Uu][Rr][Cc][Ee][ \t]+"([^"]+)"/\1/s,resource/
--regex-ooRexx=/^[ \t]*::[Rr][Ee][Ss][Oo][Uu][Rr][Cc][Ee][ \t]+([A-Za-z_][A-Za-z0-9_!?]*)/\1/s,resource/
--regex-ooRexx=/^[ \t]*::[Aa][Nn][Nn][Oo][Tt][Aa][Tt][Ee][ \t]+[Pp][Aa][Cc][Kk][Aa][Gg][Ee][ \t]+([A-Za-z_][A-Za-z0-9_!?]*)/package:\1/n,annotation/
--regex-ooRexx=/^[ \t]*::[Aa][Nn][Nn][Oo][Tt][Aa][Tt][Ee][ \t]+[Cc][Ll][Aa][Ss][Ss][ \t]+['"]?([A-Za-z_][A-Za-z0-9_!?]*)['"]?[ \t]+([A-Za-z_][A-Za-z0-9_!?]*)/\1:\2/n,annotation/
--regex-ooRexx=/^[ \t]*::[Aa][Nn][Nn][Oo][Tt][Aa][Tt][Ee][ \t]+[Aa][Tt][Tt][Rr][Ii][Bb][Uu][Tt][Ee][ \t]+['"]?([A-Za-z_][A-Za-z0-9_!?]*)['"]?[ \t]+([A-Za-z_][A-Za-z0-9_!?]*)/\1:\2/n,annotation/
--regex-ooRexx=/^[ \t]*::[Aa][Nn][Nn][Oo][Tt][Aa][Tt][Ee][ \t]+[Cc][Oo][Nn][Ss][Tt][Aa][Nn][Tt][ \t]+['"]?([A-Za-z_][A-Za-z0-9_!?]*)['"]?[ \t]+([A-Za-z_][A-Za-z0-9_!?]*)/\1:\2/n,annotation/
--regex-ooRexx=/^[ \t]*::[Aa][Nn][Nn][Oo][Tt][Aa][Tt][Ee][ \t]+[Mm][Ee][Tt][Hh][Oo][Dd][ \t]+['"]?([A-Za-z_][A-Za-z0-9_!?]*)['"]?[ \t]+([A-Za-z_][A-Za-z0-9_!?]*)/\1:\2/n,annotation/
--regex-ooRexx=/^[ \t]*::[Aa][Nn][Nn][Oo][Tt][Aa][Tt][Ee][ \t]+[Rr][Oo][Uu][Tt][Ii][Nn][Ee][ \t]+['"]?([A-Za-z_][A-Za-z0-9_!?]*)['"]?[ \t]+([A-Za-z_][A-Za-z0-9_!?]*)/\1:\2/n,annotation/
--regex-ooRexx=/^[ \t]*::[Rr][Ee][Qq][Uu][Ii][Rr][Ee][Ss][ \t]+"([^"]+)"/\1/q,require/
--regex-ooRexx=/^[ \t]*::[Rr][Ee][Qq][Uu][Ii][Rr][Ee][Ss][ \t]+'([^']+)'/\1/q,require/
--regex-ooRexx=/^[ \t]*::[Rr][Ee][Qq][Uu][Ii][Rr][Ee][Ss][ \t]+([^ \t;]+)/\1/q,require/
--regex-ooRexx=/^[ \t]*::[Oo][Pp][Tt][Ii][Oo][Nn][Ss][ \t]+([A-Za-z_][A-Za-z0-9_]*)/\1/o,option/
